# ── Telegram ──────────────────────────────────────────────
TELEGRAM_TOKEN=your-telegram-bot-token

# ── Access control ────────────────────────────────────────
# Telegram user ids allowed to use the bot (comma-separated).
# Bootstrap: leave empty, message the bot once, read your id from the
# logs ("Dropped update from unauthorized sender"), paste it here, restart.
AUTHORIZED_USER_IDS=

# ── Gemini (OCR + Normalization) ─────────────────────────
GEMINI_API_KEY=your-gemini-api-key
# Optional: override the Gemini model (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# ── Google Sheets ────────────────────────────────────────
# Path to the service-account credentials JSON file
GOOGLE_SHEETS_CREDENTIALS=credentials.json

# The ID of the target spreadsheet (the long string in the URL)
GOOGLE_SHEETS_ID=your-google-sheets-id-id
